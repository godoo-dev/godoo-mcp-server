{
  "name": "@godoo-dev/mcp-server",
  "version": "0.3.0",
  "description": "Stateless operational Odoo MCP for Node and Cloudflare Workers",
  "type": "module",
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3",
  "bin": {
    "godoo-mcp-server": "dist/node.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./worker": "./dist/worker.mjs"
  },
  "files": [
    "dist",
    "src/godoo_mcp_server/skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ts tests/ts scripts/*.mjs",
    "test": "vitest run",
    "start": "node dist/node.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "5.20261102.1",
    "@godoo-dev/client": "0.8.0",
    "@godoo-dev/testcontainers": "1.0.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/debug": "4.1.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "25.9.1",
    "aws4fetch": "1.0.20",
    "debug": "4.4.3",
    "esbuild": "0.27.0",
    "markdown-it": "14.1.0",
    "miniflare": "5.20261101.0-beta",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "wrangler": "4.156.1",
    "zod": "4.3.6"
  }
}
